# ==============================================================================
# WorkLanka Environment Variables Configuration
# ==============================================================================

# Application & Brand Configuration
# Can be changed to white-label or re-brand the platform
NEXT_PUBLIC_APP_NAME="Prime Hire"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@primehire.lk"
NODE_ENV="development"

# Database (PostgreSQL 16)
# Local docker-compose URL: postgresql://worklanka_user:worklanka_secret_password@localhost:5432/worklanka_db
DATABASE_URL="postgresql://worklanka_user:worklanka_secret_password@localhost:5432/worklanka_db?schema=public"

# Auth.js / NextAuth v5 Configuration
# Generate a secret using `openssl rand -base64 33`
AUTH_SECRET="worklanka_super_secret_auth_key_must_be_at_least_32_characters_long_for_security"
AUTH_URL="http://localhost:3000"

# Google OAuth (Optional - toggled with GOOGLE_OAUTH_ENABLED)
GOOGLE_OAUTH_ENABLED="false"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email Adapter Configuration
# Options: "nodemailer" (for local Mailpit) or "resend" (for production)
EMAIL_PROVIDER="nodemailer"

# Nodemailer / Mailpit (Local Development)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
EMAIL_FROM="Prime Hire <noreply@primehire.lk>"

# Resend API (Production)
RESEND_API_KEY=""

# Security & Cloudflare Turnstile / hCaptcha (Optional - toggled with CAPTCHA_ENABLED)
CAPTCHA_ENABLED="false"
CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET_KEY=""

# Rate Limiting Configuration
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900

